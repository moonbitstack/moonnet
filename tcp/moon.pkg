// TCP and TLS over TCP on moonbitlang/async sockets: a connection that reads and writes the same
// whether encrypted or not, the accept loop, and the dialler.
// TLS 1.3, RFC 8446: https://www.rfc-editor.org/rfc/rfc8446
//
// The sockets exist on the native and wasm backends only, so the package is empty elsewhere.
import {
  "moonbitstack/moontls/tls",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/async/socket",
  "moonbitlang/core/cmp",
  "moonbitlang/core/env",
}

import {
  "moonbitstack/moonnet/tcp",
  "moonbitstack/moontls/tls",
  "moonbitstack/mooncred/x509",
  "moonbitlang/async",
  "moonbitlang/async/socket",
} for "test"

// `-alert_internal`: the `@io.Reader` contract returns a buffer type async marks internal, and
// implementing that contract is what lets a connection be read like any async stream.

warnings = "-alert_internal-29"

options(
  targets: {
    "conn.mbt": [ "native", "wasm" ],
    "serve.mbt": [ "native", "wasm" ],
    "tcp_test.mbt": [ "native", "wasm" ],
    "stress_test.mbt": [ "native" ],
    "fixtures_test.mbt": [ "native", "wasm" ],
  },
)
