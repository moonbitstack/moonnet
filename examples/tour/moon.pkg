// Everything this repository does, in one run: `moon run examples/tour`.
pkgtype(kind: "executable")

import {
  "moonbitstack/moonnet/tcp",
  "moonbitstack/moontls/tls",
  "moonbitstack/mooncred/x509",
  "moonbitstack/mooncrypt/sign/ecdsa",
  "moonbitlang/async",
  "moonbitlang/async/socket",
  "moonbitlang/core/env",
}

warnings = "-29"

options(
  targets: {
    "tour.mbt": [ "native", "wasm" ],
    "elsewhere.mbt": [ "js", "wasm-gc" ],
  },
)
